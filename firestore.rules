rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Dedicated helper for active authenticated users
    function isActiveUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().get('isActive', false) == true;
    }

    // Core multi-role checking helper with backward-compatibility & priority enforcement
    function hasRole(targetRole) {
      return isActiveUser() && (
        ('roles' in getUserData() && getUserData().roles is list)
          ? getUserData().roles.hasAny([targetRole])
          : getUserData().get('role', '') == targetRole
      );
    }

    function isSuperAdmin() {
      return hasRole('superadmin');
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }

    function isCleaner() {
      return hasRole('cleaner');
    }

    function isTeacher() {
      return hasRole('teacher');
    }

    function isCleanerOrAdmin() {
      return isCleaner() || isAdmin();
    }

    function getUserRole() {
      return isActiveUser() ? getUserData().get('role', null) : null;
    }

    // Helpers for Super Admin boundary protection
    function requestHasSuperAdmin() {
      return request.resource.data.get('role', '') == 'superadmin' ||
        (request.resource.data.get('roles', []) is list && request.resource.data.get('roles', []).hasAny(['superadmin']));
    }

    function resourceHasSuperAdmin() {
      return resource.data.get('role', '') == 'superadmin' ||
        (resource.data.get('roles', []) is list && resource.data.get('roles', []).hasAny(['superadmin']));
    }

    function canAdminUpdateUser(userId) {
      return isAdmin() &&
        request.auth.uid != userId &&
        !resourceHasSuperAdmin() &&
        !requestHasSuperAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']);
    }

    function isValidUserSelfCreate(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.isActive == true &&
        request.resource.data.get('role', 'cleaner') in ['cleaner', 'teacher'] &&
        (!('roles' in request.resource.data) || (request.resource.data.roles is list && !request.resource.data.roles.hasAny(['superadmin', 'admin'])));
    }

    // Helper to verify if request.auth.uid is assigned teacher of classId
    function isClassTeacher(classId) {
      return isTeacher() && classId != null && (
        exists(/databases/$(database)/documents/teacher_class_assignments/$(request.auth.uid + '_' + classId)) ||
        (exists(/databases/$(database)/documents/classes/$(classId)) &&
         get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherId == request.auth.uid)
      );
    }

    // FIX Audit 06: Helper to verify if teacher owns the parent inspection of an item
    function isInspectionItemClassTeacher(inspectionId) {
      return isTeacher() && inspectionId != null &&
        exists(/databases/$(database)/documents/inspections/$(inspectionId)) &&
        isClassTeacher(get(/databases/$(database)/documents/inspections/$(inspectionId)).data.classId);
    }

    // FIX Audit 06: Strict payment transition validation for Cleaner
    function isValidCleanerPenaltyPayment() {
      return isCleaner() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'paid' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'paidAt', 'paidReceivedById', 'receiptNumber', 'updatedAt'
        ]) &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.violationId == resource.data.violationId &&
        request.resource.data.classId == resource.data.classId &&
        request.resource.data.issuedById == resource.data.issuedById &&
        request.resource.data.issuedDate == resource.data.issuedDate &&
        request.resource.data.responsiblePerson == resource.data.responsiblePerson &&
        request.resource.data.paidAt != null &&
        request.resource.data.paidReceivedById != null &&
        request.resource.data.receiptNumber != null;
    }

    // Strict cancellation transition validation for Cleaner
    function isValidCleanerPenaltyCancellation() {
      return isCleaner() &&
        resource.data.status != 'cancelled' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledById', 'cancelledByName', 'cancellationReason', 'updatedAt'
        ]) &&
        request.resource.data.cancelledAt != null &&
        request.resource.data.cancelledById == request.auth.uid &&
        request.resource.data.cancellationReason != null;
    }

    // Strict violation cancellation transition validation for Cleaner
    function isValidCleanerViolationCancellation() {
      return isCleaner() &&
        resource.data.status != 'cancelled' &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledAt', 'cancelledById', 'cancelledByName', 'cancellationReason', 'updatedAt'
        ]) &&
        request.resource.data.cancelledAt != null &&
        request.resource.data.cancelledById == request.auth.uid &&
        request.resource.data.cancellationReason != null;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCleanerOrAdmin() || isTeacher());
      allow create: if isSuperAdmin() ||
        (isAdmin() && !requestHasSuperAdmin()) ||
        isValidUserSelfCreate(userId);
      allow update: if isSuperAdmin() ||
        canAdminUpdateUser(userId) ||
        (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles', 'isActive']));
      allow delete: if isSuperAdmin() || (isAdmin() && !resourceHasSuperAdmin());
    }

    // ============================================================
    // CLASSES COLLECTION
    // ============================================================
    match /classes/{classId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ============================================================
    // TEACHER CLASS ASSIGNMENTS
    // ============================================================
    match /teacher_class_assignments/{assignmentId} {
      allow read: if isCleanerOrAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ============================================================
    // AREAS COLLECTION
    // ============================================================
    match /areas/{areaId} {
      allow read: if isActiveUser();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // SCHEDULES COLLECTION
    // ============================================================
    match /schedules/{scheduleId} {
      allow read: if isActiveUser();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // INSPECTIONS & INSPECTION ITEMS
    // ============================================================
    match /inspections/{inspectionId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.inspectorId == request.auth.uid);
      allow update: if isAdmin() || (isCleaner() && resource.data.inspectorId == request.auth.uid && request.resource.data.inspectorId == resource.data.inspectorId);
      allow delete: if isAdmin() || (isCleaner() && resource.data.inspectorId == request.auth.uid);
    }

    match /inspection_items/{itemId} {
      allow read: if isCleanerOrAdmin() || (resource.data.inspectionId != null && isInspectionItemClassTeacher(resource.data.inspectionId));
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isCleanerOrAdmin();
    }

    // ============================================================
    // VIOLATION TYPES & PENALTY RULES
    // ============================================================
    match /violation_types/{typeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /penalty_rules/{ruleId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    // ============================================================
    // VIOLATIONS
    // ============================================================
    match /violations/{violationId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.reportedById == request.auth.uid);
      allow update: if isAdmin() || (isCleaner() && resource.data.reportedById == request.auth.uid && request.resource.data.reportedById == resource.data.reportedById) || isValidCleanerViolationCancellation();
      allow delete: if isAdmin();
    }

    // ============================================================
    // PENALTIES
    // ============================================================
    match /penalties/{penaltyId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.issuedById == request.auth.uid);
      allow update: if isAdmin() || isValidCleanerPenaltyPayment() || isValidCleanerPenaltyCancellation();
      allow delete: if isAdmin();
    }

    // ============================================================
    // PHOTOS COLLECTION
    // ============================================================
    match /photos/{photoId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() || (isCleaner() && request.resource.data.uploadedById == request.auth.uid);
      allow update, delete: if isAdmin() || (isCleaner() && resource.data.uploadedById == request.auth.uid);
    }

    // ============================================================
    // INVENTORIES & INVENTORY LOGS
    // ============================================================
    match /inventories/{inventoryId} {
      allow read: if isActiveUser();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    match /inventory_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() || (isCleaner() && request.resource.data.performedById == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
