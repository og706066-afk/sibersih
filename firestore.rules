rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // FIX 3: Enforce isActive == true for all role authorizations
    function getUserRole() {
      return (isAuthenticated() && getUserData().isActive == true) 
        ? getUserData().role 
        : null;
    }

    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isCleaner() {
      return getUserRole() == 'cleaner';
    }
    
    function isTeacher() {
      return getUserRole() == 'teacher';
    }

    // FIX 5: Optimized to evaluate getUserRole() once
    function isCleanerOrAdmin() {
      let role = getUserRole();
      return role == 'admin' || role == 'cleaner';
    }

    // FIX 1: Helper to verify if request.auth.uid is assigned teacher of classId
    function isClassTeacher(classId) {
      return isTeacher() && classId != null && (
        exists(/databases/$(database)/documents/teacher_class_assignments/$(request.auth.uid + '_' + classId)) ||
        (exists(/databases/$(database)/documents/classes/$(classId)) &&
         get(/databases/$(database)/documents/classes/$(classId)).data.homeroomTeacherId == request.auth.uid)
      );
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCleanerOrAdmin() || isTeacher());
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && request.resource.data.role in ['cleaner', 'teacher'] && request.resource.data.isActive == true && request.resource.data.uid == userId);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']));
      allow delete: if isAdmin();
    }

    // ============================================================
    // CLASSES COLLECTION
    // ============================================================
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // TEACHER CLASS ASSIGNMENTS
    // ============================================================
    match /teacher_class_assignments/{assignmentId} {
      allow read: if isCleanerOrAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ============================================================
    // AREAS COLLECTION
    // FIX 3: Cleaner/Admin can create/update, delete ONLY Admin
    // ============================================================
    match /areas/{areaId} {
      allow read: if isAuthenticated();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // SCHEDULES COLLECTION
    // FIX 3: Cleaner/Admin can create/update, delete ONLY Admin
    // ============================================================
    match /schedules/{scheduleId} {
      allow read: if isAuthenticated();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // INSPECTIONS & INSPECTION ITEMS
    // FIX 1: Teacher can ONLY read inspections for their assigned class
    // FIX 4: Creator UID binding on create & update (inspectorId == request.auth.uid)
    // ============================================================
    match /inspections/{inspectionId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.inspectorId == request.auth.uid);
      allow update: if isAdmin() || (isCleaner() && resource.data.inspectorId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /inspection_items/{itemId} {
      allow read: if isAuthenticated();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // VIOLATION TYPES & PENALTY RULES
    // FIX 2: Admin only for write. Cleaner/Teacher READ ONLY.
    // ============================================================
    match /violation_types/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /penalty_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================================
    // VIOLATIONS
    // FIX 1: Teacher can ONLY read violations for their assigned class
    // FIX 4: Creator UID binding on create & update (reportedById == request.auth.uid)
    // ============================================================
    match /violations/{violationId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.reportedById == request.auth.uid);
      allow update: if isAdmin() || (isCleaner() && resource.data.reportedById == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ============================================================
    // PENALTIES
    // FIX 1: Teacher can ONLY read penalties for their assigned class
    // FIX 4: Creator UID binding on create (issuedById == request.auth.uid)
    // ============================================================
    match /penalties/{penaltyId} {
      allow read: if isCleanerOrAdmin() || (resource.data.classId != null && isClassTeacher(resource.data.classId));
      allow create: if isAdmin() || (isCleaner() && request.resource.data.issuedById == request.auth.uid);
      allow update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    // ============================================================
    // PHOTOS COLLECTION
    // FIX 4: Creator UID binding on create & delete (uploadedById == request.auth.uid)
    // ============================================================
    match /photos/{photoId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isCleaner() && request.resource.data.uploadedById == request.auth.uid);
      allow update, delete: if isAdmin() || (isCleaner() && resource.data.uploadedById == request.auth.uid);
    }

    // ============================================================
    // INVENTORIES & INVENTORY LOGS
    // FIX 2: Cleaner CANNOT delete inventory
    // FIX 4: Creator UID binding on create (performedById == request.auth.uid)
    // ============================================================
    match /inventories/{inventoryId} {
      allow read: if isAuthenticated();
      allow create, update: if isCleanerOrAdmin();
      allow delete: if isAdmin();
    }

    match /inventory_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isCleaner() && request.resource.data.performedById == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
